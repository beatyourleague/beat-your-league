# Cached API data and any local secrets stay out of the repo (CLAUDE.md security)
data/
.env
.env.*

# Per-subscriber output (personal league data; the registry itself is under data/)
reports/subscribers/
# Dry-run drafts: real subscriber addresses and their personalised reports.
reports/outbox/
# Generated reports name real league members (rival, opponent, waiver rivals).
# The anonymised public demo is site/sample-report.html, built through
# render.report.anonymize_for_public(); these raw renders must not be tracked.
reports/rival-report-*.html
reports/rival-report-*.txt

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# OS noise
.DS_Store

# Local Claude Code session settings
.claude/settings.local.json
